{
  "name": "dsh-use-chatgpt",
  "version": "1.0.5",
  "description": "在 DeepSeek Harness 中使用你的 ChatGPT 套餐额度。",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houyanchao/dsh-use-chatgpt.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["locale/*.json", "dist", "docs/images/chatgpt-settings.png", "native/credential-key", "native/credential-key-universal", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-model-selection"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs && node scripts/build-native.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "openai": "7.21.0",
    "proper-lockfile": "4.1.2"
  },
  "overrides": {
    "graceful-fs": "4.2.11"
  }
}
